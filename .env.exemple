# Copie ce fichier en .env puis adapte les valeurs.

# Nom de domaine servi par Traefik
DOMAIN=neonpass.uned.live

# Numéro WhatsApp qui reçoit les commandes (format international, chiffres uniquement)
WA_NUMBER=972553092655

# Base de données (mot de passe long et aléatoire)
DB_PASSWORD=change-moi-avec-un-mot-de-passe-long

# Accès à l'administration : https://neonpass.uned.live/admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-moi-8-caracteres-minimum

# Réglages Traefik : adapte-les à ta configuration existante
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Notifications admin (facultatif, laisser vide pour désactiver)
# Telegram : crée un bot avec @BotFather, puis récupère ton chat_id (ex. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord : Paramètres du salon > Intégrations > Webhooks > Copier l'URL
DISCORD_WEBHOOK_URL=

# Configuration SMTP Email (Google Gmail - OTP & Campagnes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=neonpass.officiel@gmail.com
SMTP_PASS=mrsbklwwfjmmiuvq
SMTP_FROM="NeonPass <neonpass.officiel@gmail.com>"
